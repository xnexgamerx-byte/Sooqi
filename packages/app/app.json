    "plugins": ["expo-router"],
    "android": {
      "package": "iq.souqna.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": { "backgroundColor": "#0B5FD9" }
    },
    "ios": {
      "bundleIdentifier": "iq.souqna.app",
      "supportsTablet": false
    }
  }
}
