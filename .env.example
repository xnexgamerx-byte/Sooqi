# انسخ إلى .env — الملف مستثنى من git

# قاعدة البيانات (Supabase: Connect -> Session pooler)
# رمّز الرموز الخاصة في كلمة المرور، مثلاً $ تصير %24
DATABASE_URL=postgres://user:pass@host:5432/souqna

PORT=5000
NODE_ENV=development

# --- تخزين الصور: Cloudflare R2 ---
# عبّئ الأربعة كلها أو اتركها كلها فارغة؛ مجموعة ناقصة توقف الخادم عن
# الإقلاع بدل أن تفشل عند أول رفع.
# Cloudflare -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=souqna-media
# النطاق العام الذي يقدّم الصور. مطلوب مع الإعدادات أعلاه.
# اربط نطاقاً فرعياً بالحاوية من R2 -> Settings -> Public access
R2_PUBLIC_URL=

# --- مصادقة مؤقتة للتطوير فقط ---
# تسمح بتمرير x-user-id في الترويسة بدل تسجيل دخول حقيقي.
# ترفض الإقلاع إذا كانت مفعّلة مع NODE_ENV=production.
DEV_AUTH=1

# --- تسجيل الدخول بحساب Google (اختياري) ---
# console.cloud.google.com -> APIs & Services -> Credentials
# فارغ يخفي زر Google من شاشة الدخول.
GOOGLE_CLIENT_ID=

# --- بوابة الرسائل القصيرة ---
# console: يطبع الرمز في السجلّ ولا يرسل شيئاً. مناسب للتطوير والبيتا.
# http:    يرسل POST {to, message} إلى SMS_API_URL بمفتاح في Authorization.
# الخادم يحذّر عند الإقلاع إذا بقي console في الإنتاج.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
