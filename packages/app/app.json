{
  "expo": {
    "name": "سوقنا",
    "slug": "souqna",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "souqna",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#EFEFF4",
    "extra": {
      "router": {}
