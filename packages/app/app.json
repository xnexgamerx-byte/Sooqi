{
  "expo": {
    "name": "سوقنا",
    "slug": "souqna",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "souqna",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#EFEFF4",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c3f3b8d-84a6-415d-86a0-b3711b0fe1fa"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج سوقنا الوصول لصورك حتى تضيفها إلى إعلانك.",
          "cameraPermission": "يحتاج سوقنا الكاميرا حتى تصوّر ما تريد بيعه."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B5FD9"
        }
      ]
    ],
    "android": {
      "package": "iq.souqna.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#0B5FD9"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "iq.souqna.app",
      "supportsTablet": false
    },
    "notification": {
      "iosDisplayInForeground": true
    }
  }
}
